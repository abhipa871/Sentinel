APP_ENV=development
DATABASE_URL=postgresql+psycopg://sentinel:change-me@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=sentinel-artifacts
MODEL_PROVIDER=
MODEL_ID_SUPERVISOR=
MODEL_ID_CODE_ANALYSIS=
MODEL_ID_REVIEW=
# Local server process only. Production loads provider credentials from a secret manager.
GOOGLE_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible providers, e.g. --model moonshot:kimi-k3
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
DEFAULT_SCAN_PROFILE=balanced
SANDBOX_NETWORK_POLICY=deny
ENABLE_SOURCE_WRITES=false
ENABLE_AUTOMATED_PR=false

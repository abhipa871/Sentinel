# Required for semantic analysis. Never store a real key here; structure-only mode needs no key.
OPENAI_API_KEY=
SENTINEL_MODEL=gpt-4.1-mini
# API only analyzes repositories under this directory (defaults to current directory).
SENTINEL_REPO_ROOT=.
SENTINEL_STATE_DIR=.sentinel

# Alternative provider (set via process environment).
# SENTINEL_PROVIDER=openrouter
# SENTINEL_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# Native Google provider (process environment).
# SENTINEL_PROVIDER=gemini
# SENTINEL_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
